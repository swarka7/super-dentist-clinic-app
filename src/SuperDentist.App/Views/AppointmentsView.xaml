<UserControl x:Class="SuperDentist.App.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SuperDentist.App.Behaviors"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
            <TextBlock Text="Appointments" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Schedule and manage appointments." Style="{StaticResource SubtleText}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Patient" />
            <ComboBox ItemsSource="{Binding Patients}"
                      DisplayMemberPath="Id"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Doctor" />
            <ComboBox ItemsSource="{Binding Doctors}"
                      DisplayMemberPath="Id"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DoctorId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Date (YYYY-MM-DD)" />
            <TextBox x:Name="DateBox"
                     Text="{Binding AppointmentDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="10"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9-]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=DateBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=DateBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Time (HH:MM)" />
            <TextBox x:Name="TimeBox"
                     Text="{Binding AppointmentTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="5"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9:]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=TimeBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=TimeBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Treatment" />
            <ComboBox ItemsSource="{Binding Treatments}"
                      DisplayMemberPath="Number"
                      SelectedValuePath="Number"
                      SelectedValue="{Binding TreatmentNumber, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add" Command="{Binding AddCommand}" />
                <Button Content="Update" Command="{Binding UpdateCommand}" Margin="8,6,0,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="8,6,0,0" Background="{StaticResource Brush.Danger}" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,6,0,0" Style="{StaticResource GhostButton}" />
            </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Schedule" Style="{StaticResource HeadingText}" />

            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Appointments}"
                      SelectedItem="{Binding SelectedAppointment}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="110" />
                    <DataGridTextColumn Header="Doctor ID" Binding="{Binding DoctorId}" Width="110" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90" />
                    <DataGridTextColumn Header="Treatment" Binding="{Binding TreatmentNumber}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
