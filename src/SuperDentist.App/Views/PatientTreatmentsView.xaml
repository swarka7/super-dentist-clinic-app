<UserControl x:Class="SuperDentist.App.Views.PatientTreatmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SuperDentist.App.Behaviors"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
            <TextBlock Text="Patient Treatments" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Track treatment progress and payments." Style="{StaticResource SubtleText}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Patient" />
            <ComboBox ItemsSource="{Binding Patients}"
                      DisplayMemberPath="Id"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Treatment" />
            <ComboBox ItemsSource="{Binding Treatments}"
                      DisplayMemberPath="Number"
                      SelectedValuePath="Number"
                      SelectedValue="{Binding TreatmentNumber, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Completed" />
            <ComboBox ItemsSource="{Binding YesNoOptions}"
                      SelectedItem="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Paid" />
            <ComboBox ItemsSource="{Binding YesNoOptions}"
                      SelectedItem="{Binding IsPaid, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Start Date" />
            <TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="10"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9-]*$" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add" Command="{Binding AddCommand}" />
                <Button Content="Update" Command="{Binding UpdateCommand}" Margin="8,6,0,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="8,6,0,0" Background="{StaticResource Brush.Danger}" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,6,0,0" Style="{StaticResource GhostButton}" />
            </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Overview" Style="{StaticResource HeadingText}" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PatientTreatments}"
                          SelectedItem="{Binding SelectedPatientTreatment}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="110" />
                        <DataGridTextColumn Header="Treatment" Binding="{Binding TreatmentNumber}" Width="110" />
                        <DataGridTextColumn Header="Completed" Binding="{Binding IsCompleted}" Width="100" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding IsPaid}" Width="90" />
                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
