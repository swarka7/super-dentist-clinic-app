<UserControl x:Class="SuperDentist.App.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SuperDentist.App.Behaviors"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
            <TextBlock Text="Patients" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Track patient information and treatment status." Style="{StaticResource SubtleText}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Patient ID" />
            <TextBox x:Name="PatientIdBox"
                     Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="9"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=PatientIdBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=PatientIdBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Doctor" />
            <ComboBox ItemsSource="{Binding Doctors}"
                      DisplayMemberPath="Id"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DoctorId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="First Name" />
            <TextBox x:Name="FirstNameBox"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[A-Za-z\s-]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=FirstNameBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=FirstNameBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Last Name" />
            <TextBox x:Name="LastNameBox"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[A-Za-z\s-]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=LastNameBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=LastNameBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Address" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Phone" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="10"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9]*$" />

            <TextBlock Text="Email" />
            <TextBox x:Name="EmailBox"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=EmailBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=EmailBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Age" />
            <TextBox x:Name="AgeBox"
                     Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     MaxLength="3"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=AgeBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=AgeBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Treatment Status" />
            <ComboBox ItemsSource="{Binding TreatmentStatuses}"
                      SelectedItem="{Binding TreatmentStatus, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add" Command="{Binding AddCommand}" />
                <Button Content="Update" Command="{Binding UpdateCommand}" Margin="8,6,0,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="8,6,0,0" Background="{StaticResource Brush.Danger}" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,6,0,0" Style="{StaticResource GhostButton}" />
            </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Directory" Style="{StaticResource HeadingText}" />

            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Patients}"
                      SelectedItem="{Binding SelectedPatient}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120" />
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120" />
                    <DataGridTextColumn Header="Doctor ID" Binding="{Binding DoctorId}" Width="90" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160" />
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60" />
                    <DataGridTextColumn Header="Status" Binding="{Binding TreatmentStatus}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
