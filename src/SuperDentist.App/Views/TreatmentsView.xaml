<UserControl x:Class="SuperDentist.App.Views.TreatmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SuperDentist.App.Behaviors"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
            <TextBlock Text="Treatments" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Manage treatment catalog and pricing." Style="{StaticResource SubtleText}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Treatment Number" />
            <TextBox x:Name="TreatmentNumberBox"
                     Text="{Binding TreatmentNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=TreatmentNumberBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=TreatmentNumberBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Type" />
            <TextBox Text="{Binding TreatmentType, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Price" />
            <TextBox x:Name="PriceBox"
                     Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     behaviors:TextBoxInputBehavior.AllowedPattern="^[0-9]*$" />
            <TextBlock Style="{StaticResource ValidationErrorText}"
                       Text="{Binding ElementName=PriceBox, Path=(Validation.Errors)[0].ErrorContent}"
                       Visibility="{Binding ElementName=PriceBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Tools" />
            <TextBox Text="{Binding Tools, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add" Command="{Binding AddCommand}" />
                <Button Content="Update" Command="{Binding UpdateCommand}" Margin="8,6,0,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="8,6,0,0" Background="{StaticResource Brush.Danger}" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,6,0,0" Style="{StaticResource GhostButton}" />
            </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Catalog" Style="{StaticResource HeadingText}" />

            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Treatments}"
                      SelectedItem="{Binding SelectedTreatment}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="120" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="180" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="90" />
                    <DataGridTextColumn Header="Tools" Binding="{Binding Tools}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
