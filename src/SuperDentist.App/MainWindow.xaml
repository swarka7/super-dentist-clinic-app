<Window x:Class="SuperDentist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SuperDentist"
        WindowStartupLocation="CenterScreen"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/Assets/icon.png">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22364F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Background="{StaticResource Brush.Primary}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource Brush.Accent}">
                        <Image Source="pack://application:,,,/Assets/icon.png"
                               Width="36"
                               Height="36"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="SuperDentist" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Clinic Operations Dashboard" Foreground="#D9E2EF" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Reports" Margin="0,0,12,0" Background="#2B3D57" Foreground="White" BorderThickness="0" Padding="16,6" Command="{Binding ShowReportsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation -->
            <Border Background="{StaticResource Brush.PrimaryDark}">
                <StackPanel Margin="16,24">
                    <Button Command="{Binding ShowDoctorsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDoctorsActive}" Value="True">
                                        <Setter Property="Background" Value="#1C2E4A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Doctors" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowPatientsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPatientsActive}" Value="True">
                                        <Setter Property="Background" Value="#1C2E4A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Patients" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowAppointmentsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppointmentsActive}" Value="True">
                                        <Setter Property="Background" Value="#1C2E4A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Appointments" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowTreatmentsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTreatmentsActive}" Value="True">
                                        <Setter Property="Background" Value="#1C2E4A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Treatments" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowPatientTreatmentsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPatientTreatmentsActive}" Value="True">
                                        <Setter Property="Background" Value="#1C2E4A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Patient Treatments" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowTodayAppointmentsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodayActive}" Value="True">
                                        <Setter Property="Background" Value="#1C2E4A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Today" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Page Content -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentViewModel}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
