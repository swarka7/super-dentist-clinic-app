<Application x:Class="SuperDentist.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SuperDentist.App.Views"
             xmlns:viewModels="clr-namespace:SuperDentist.App.ViewModels"
             xmlns:converters="clr-namespace:SuperDentist.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />

            <DataTemplate DataType="{x:Type viewModels:DoctorsViewModel}">
                <views:DoctorsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PatientsViewModel}">
                <views:PatientsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TreatmentsViewModel}">
                <views:TreatmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AppointmentsViewModel}">
                <views:AppointmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PatientTreatmentsViewModel}">
                <views:PatientTreatmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PatientReportViewModel}">
                <views:PatientReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PatientDetailsViewModel}">
                <views:PatientDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TreatmentReportViewModel}">
                <views:TreatmentReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TodayAppointmentsViewModel}">
                <views:TodayAppointmentsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

